# API (local)
# Prisma 6 pool (opcional en prod multi-réplica): ?connection_limit=5&pool_timeout=10
DATABASE_URL="postgresql://buyseekk:buyseekk@localhost:5432/buyseekk?schema=public"
REDIS_URL="redis://localhost:6379"
# Lanzamiento por país: US = solo Estados Unidos (default). MULTI solo en web (dev).
LAUNCH_COUNTRY="US"
# Lanzamiento gratuito: true = sin límites de plan. En producción DEBE estar definido (true o false).
PLUS_FEATURES_UNLOCKED="true"
# URL pública de la web (emails de auth y notificaciones — obligatorio en producción)
WEB_URL="http://localhost:3000"
# Emails automáticos de notificaciones (ofertas, mensajes, alertas)
NOTIFICATION_EMAILS_ENABLED="true"
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"
JWT_EXPIRES_IN="15m"
# Cookie HttpOnly de refresh (no setear en local). Ver notas de producción abajo.
# AUTH_COOKIE_DOMAIN=".buyseek.us"
EMAIL_PROVIDER="console"
# Para enviar emails reales en Railway:
#   EMAIL_PROVIDER="resend"
#   EMAIL_API_KEY="re_..."
#   EMAIL_FROM="Buyseek <noreply@tudominio.com>"
# Sin dominio propio (solo pruebas):
#   EMAIL_FROM="Buyseek <onboarding@resend.dev>"
#   EMAIL_SANDBOX_TO="tu-email@gmail.com"
EMAIL_FROM="Buyseek <onboarding@resend.dev>"
EMAIL_SANDBOX_TO="tu-email@gmail.com"
EMAIL_API_KEY=""
# Storage: local (dev) | r2 (producción — obligatorio en Railway)
STORAGE_PROVIDER="local"
# Producción: STORAGE_PROVIDER="r2" (obligatorio; no hay fallback a disco)
# STORAGE_PUBLIC_URL="https://pub-xxxx.r2.dev"  # o custom https://media.buyseek.us
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# Futuro custom domain: en Cloudflare R2 → Custom Domains → media.buyseek.us
#   STORAGE_PUBLIC_URL="https://media.buyseek.us"
#   NEXT_PUBLIC_STORAGE_HOST="media.buyseek.us"
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"
# Observabilidad (opcional)
# SENTRY_DSN="https://...@sentry.io/..."
# Rate limiting — overrides opcionales (requests por 60s)
# THROTTLE_LOGIN_LIMIT=30
# THROTTLE_REGISTER_LIMIT=15
# THROTTLE_UPLOAD_LIMIT=30
# THROTTLE_OFFER_LIMIT=40
# THROTTLE_CHAT_LIMIT=120
# THROTTLE_SEARCH_LIMIT=200
# THROTTLE_WRITE_LIMIT=60
# THROTTLE_AUTH_EMAIL_LIMIT=10
# THROTTLE_REFRESH_LIMIT=60
# THROTTLE_DEFAULT_LIMIT=400

# Web (local) — copiar a apps/web/.env.local
NEXT_PUBLIC_LAUNCH_COUNTRY="US"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@buyseekk.com"
# Solo desarrollo local con seed (nunca en producción)
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="true"
# Hostname del CDN de imágenes (sin https://) para next/image
# NEXT_PUBLIC_STORAGE_HOST="cdn.tudominio.com"
# Observabilidad web (opcional)
# NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."
NEXT_PUBLIC_APP_VERSION="0.1.0"

# --- Producción (Railway API) — configurar vos ---
# DATABASE_URL     → referencia automática al plugin Postgres
# JWT_SECRET       → openssl rand -base64 32  (mín. 32 caracteres en producción)
# NODE_ENV         → production
# CORS_ORIGIN      → https://buyseek.us  (y https://www.buyseek.us si aplica; sin wildcard)
# WEB_URL          → https://buyseek.us  (mismo origen público que la web)
# PLUS_FEATURES_UNLOCKED → true (lanzamiento gratis) o false (límites Free). Obligatorio y explícito.
# LAUNCH_COUNTRY   → US
# EMAIL_PROVIDER   → resend (+ EMAIL_API_KEY, EMAIL_FROM verificado)
# STORAGE_PROVIDER → r2 (+ R2_* y STORAGE_PUBLIC_URL)
# REDIS_URL        → redis:// o rediss:// ; obligatorio si escalás a 2+ réplicas API
# SENTRY_DSN       → opcional pero recomendado
# PORT             → lo setea Railway (no tocar)
#
# Refresh cookie (cross-site actual: buyseek.us → API Railway):
#   HttpOnly; Secure; SameSite=None; Path=/api/auth
#   NO setear AUTH_COOKIE_DOMAIN mientras la API no viva bajo *.buyseek.us
# Futuro api.buyseek.us:
#   CORS_ORIGIN=https://buyseek.us,https://www.buyseek.us
#   AUTH_COOKIE_DOMAIN=.buyseek.us
#   WEB_URL=https://buyseek.us
#   Entonces el refresh puede pasar a SameSite=Lax (mismo sitio registrable).
# Frontend debe usar credentials: 'include' en /api/auth/* (login/register/refresh/logout).
# Sesiones viejas (refresh en localStorage) quedan inválidas: el usuario vuelve a iniciar sesión una vez.

# --- Producción (Vercel Web) — configurar vos ---
# NEXT_PUBLIC_API_URL → https://tu-api.up.railway.app  (sin /api al final)
# NEXT_PUBLIC_SITE_URL → https://buyseek.us
# NEXT_PUBLIC_LAUNCH_COUNTRY → US
# NEXT_PUBLIC_SUPPORT_EMAIL → support@buyseekk.com
# NEXT_PUBLIC_ENABLE_DEMO_LOGIN → no setear (o false). true falla el build de producción.
# NEXT_PUBLIC_STORAGE_HOST → hostname del CDN R2
# NEXT_PUBLIC_SENTRY_DSN → opcional
